# ── Model weights and checkpoints ───────────────────────────────────────────
# All pretrained/trained weights are downloaded or produced locally, never
# committed. See each subproject's README for where to get them.
*.pth
*.pth.tar
*.ckpt
*.safetensors

# ── Datasets ────────────────────────────────────────────────────────────────
# WikiText, MNIST, CIFAR, ImageNet. Auto-downloaded or documented per project.
data/
*.npy
*.tar.gz

# ── Generated caches ────────────────────────────────────────────────────────
# LFSR primitive-polynomial caches: regenerated by pgu.py via `galois` on first
# run (slow, so keep a local copy — just don't commit it).
poly/
*.pkl

# ── Run artifacts ───────────────────────────────────────────────────────────
runs/
output_*/
finetune_output/
log/
logs/
*.log
# ...but keep the small sparsity measurement logs (a few KB each). The pattern
# needs `**/` because a pattern containing `/` is anchored to this file's directory.
!**/sparsity/*.log
wik8-0.01.txt            # created by any import of SpikeGPT/src/trainer.py

# ── Figures produced by the plotting scripts ────────────────────────────────
fig_rank.png

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
build/
dist/

# ── Editors / OS / tooling ──────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
.claude/
